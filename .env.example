# Active provider
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-20b
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.7

# Cloud providers
GROQ_API_KEY=
GOOGLE_API_KEY=
OPENAI_API_KEY=

# Local or private provider
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:latest

# Optional theoretical cost estimation (USD per 1M tokens)
LLM_INPUT_RATE_PER_MILLION=
LLM_OUTPUT_RATE_PER_MILLION=
